//@version=6
// =======================================================================================
//  LOU A+ SETUP DETECTOR - V1.6 (TradingView strategy)
//
//  Range -> liquidity sweep -> reclaim -> entry -> target
//
//  Four independent range setups, each with its own on/off switch, its own time windows
//  and its own trade counter. All four follow exactly the same rules:
//
//    ASIA    02:00-06:00   entries 06:00-10:00
//    LONDON  07:12-08:12   entries 08:12-10:00
//    LUNCH   12:00-13:00   entries 13:00-14:15
//    NY      14:12-15:12   entries 15:30-16:30
//
//  Entry models (shared by all four)
//    1  OB   first M5 candle closing outside the range becomes the orderblock.
//            Entry on the close back beyond that OB and inside the range.
//    2  FIB  fib from the sweep extreme to the reclaim extreme, limit at 0.618.
//
//  Stop loss, take-profit model, no-trade zone, session locks and risk sizing apply
//  to all four ranges in the same way.
//
//  Legacy models (off by default, kept for comparison)
//    Asia OB with R-based targets, and the original London model with the Asia
//    location filter plus double sweep.
//
//  Chart   M5. Ranges, sweeps, limit fills and SL/TP resolution come from M1 intrabars
//          (request.security_lower_tf), so the xx:12 ranges are exact.
//  Time    Europe/Vienna including DST, no broker offset needed.
//  Repaint All logic runs on confirmed bars only. No lookahead, no future data.
//
//  See KNOWN LIMITS at the end of the file.
// =======================================================================================
strategy("Lou-A+ V1.9.6", shorttitle = "Lou-A+ 196", overlay = true, process_orders_on_close = true, pyramiding = 10, initial_capital = 10000, margin_long = 0, margin_short = 0, default_qty_type = strategy.fixed, default_qty_value = 1, commission_value = 0, slippage = 0, use_bar_magnifier = false, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ═══════════════════════════════════════════════════════════════════════════════════════
// 0. KONSTANTEN
// ═══════════════════════════════════════════════════════════════════════════════════════
// --- States -----------------------------------------------------------------------------
const int ST_IDLE          = 0
const int ST_BUILD_ASIA    = 1
const int ST_BUILD_PRE     = 2
const int ST_WAIT_SWEEP    = 3
const int ST_WAIT_RECLAIM  = 4
const int ST_WAIT_ENTRY    = 5
const int ST_CUTOFF        = 6
const int ST_MAX_TRADES    = 7
const int ST_INVALID_LOC   = 8
const int ST_NO_DATA       = 9

// --- Asia-OB States ---------------------------------------------------------------------
const int AS_WAIT_RANGE    = 0
const int AS_WAIT_SWEEP    = 1
const int AS_WAIT_RECLAIM  = 2
const int AS_CUTOFF        = 3
const int AS_MAX_TRADES    = 4

// --- Optionen ---------------------------------------------------------------------------
const string DS_REQ  = "Required (sweep Asia + Pre)"
const string DS_OPT  = "Optional (Asia is enough, Pre is flagged)"
const string OB_WICK = "OB low / high (wick)"
const string OB_BODY = "OB body (open / close)"
const string TP_DUAL = "Dual TP  (TP1 + TP2)"
const string TP_FULL = "Single TP  Full range (100 % / opposite side)"
const string TP_HALF = "Single TP  50 % (range mid)"
const string TP_CUST = "Single TP  Custom %"
const string ATP_DUAL   = "Dual TP  (TP1 + TP2 in R)"
const string ATP_SINGLE = "Single TP  (TP2 in R)"
const string LOCK_FIRST = "First TP (TP1 or single TP)"
const string LOCK_FINAL = "Final TP only"
const string LOCK_OFF   = "Off"

const string G_SESS   = "2 Timezone"
const string G_RA     = "3a Asia range"
const string G_RL     = "3b London range"
const string G_LOC    = "7b Legacy London"
const string G_OB     = "4a Entry model 1: Orderblock reclaim"
const string G_FIB    = "4b Entry model 2: Fib retrace limit"
const string G_AOB    = "7a Legacy Asia OB"
const string G_STRAT  = "1 Risk & account"
const string G_NY     = "3d NY range"
const string G_LUN    = "3c Lunch range"
const string G_LOCK   = "6b Session locks"
const string G_NTZ    = "6c No-trade zone (50 % mark)"
const string G_RISK   = "6a Stop loss / Take profit (all models)"
const string G_ENG    = "4c Entry model 3: 3-candle engulfing"
const string G_FIV    = "4d Entry model 4: FVG inversion"
const string G_LIQ    = "5 Liquidity filters (model 1 only)"
const string G_VIS    = "8 Visuals"
const string G_COL    = "9 Colors"
const string G_DBG    = "10 Debug"

// ═══════════════════════════════════════════════════════════════════════════════════════
// 1. INPUTS
// ═══════════════════════════════════════════════════════════════════════════════════════

// ───────────────────────────────────────────────────────────────────────────────────────
// 1  RISIKO & KONTO
// ───────────────────────────────────────────────────────────────────────────────────────
float  riskPct   = input.float(1.0, "Risk per trade (% of equity)", minval = 0.01, step = 0.1, group = G_STRAT, tooltip = "Position size = equity x risk % / (SL distance x point value).")
int    btStartY  = input.int(2026, "Backtest from year", minval = 2000, maxval = 2100, group = G_STRAT, inline = "bt")
int    btStartM  = input.int(1, "Month", minval = 1, maxval = 12, group = G_STRAT, inline = "bt")
int    btStartD  = input.int(1, "Day", minval = 1, maxval = 31, group = G_STRAT, inline = "bt", tooltip = "Nothing is calculated before this date. Saves compute time.")
float  fixedQty  = input.float(0.0, "Fixed order size (0 = risk-based sizing)", minval = 0, step = 0.01, group = G_STRAT, tooltip = "Fallback for symbols whose point value yields no usable size.")
float  lotStep   = input.float(0.01, "Min. lot step", minval = 0.0001, step = 0.01, group = G_STRAT)
int    dayMaxSL   = input.int(0, "Stop for the day after X stop-losses (0 = off)", minval = 0, maxval = 10, group = G_STRAT, tooltip = "Counts full stop-losses across all ranges; then no new trades that day.")
bool   dayStopTP  = input.bool(false, "Stop for the day after one full target", group = G_STRAT, tooltip = "A trade reaching its final target ends the trading day.")
bool   flattenOrph = input.bool(true, "Close positions the script no longer tracks", group = G_STRAT, tooltip = "Closes a leftover position that the script no longer tracks for two bars. Guards against rounding residues.")
bool   allowCounter = input.bool(false, "Allow counter-direction trades", group = G_STRAT, tooltip = "Off: no trade against an open position. On: block lifted - careful, TradingView holds one net position.")
string lockMode  = input.string(LOCK_OFF, "Stop trading for the day after", options = [LOCK_FIRST, LOCK_FINAL, LOCK_OFF], group = G_STRAT, tooltip = "Once reached, no new trades for the rest of the day.")

// ───────────────────────────────────────────────────────────────────────────────────────
// 2  ZEITZONE
// ───────────────────────────────────────────────────────────────────────────────────────
string tzInput       = input.string("Europe/Vienna", "Timezone", options = ["Europe/Vienna", "Europe/Berlin", "UTC+1"], group = G_SESS, tooltip = "Vienna and Berlin follow CET incl. DST. UTC+1 is fixed CET.")

// ───────────────────────────────────────────────────────────────────────────────────────
// 3a ASIA RANGE
// ───────────────────────────────────────────────────────────────────────────────────────
bool   useAsia       = input.bool(true, "Asia range active", group = G_RA, tooltip = "Standalone range setup: sweep of the Asia high or low, OB reclaim or fib limit, targets measured on the Asia range. No location condition.")
string asiaSessInput = input.session("0200-0600", "Asia range", group = G_RA, tooltip = "Start inclusive, end exclusive. Sessions crossing midnight are not supported.")
string asiaWinInput  = input.session("0600-1000", "Entry window", group = G_RA)
int    asiaFibEndH   = input.int(11, "Fib limit valid until", minval = 0, maxval = 23, group = G_RA, inline = "afe")
int    asiaFibEndM   = input.int(0, ":", minval = 0, maxval = 59, group = G_RA, inline = "afe")
float  sweepDistPct  = input.float(0.0, "Min. sweep distance (% of range)", minval = 0, step = 0.5, group = G_RA, tooltip = "How far price must trade beyond the range high/low before the sweep counts, as a % of the range height. 0 = one tick is enough.")
float  asiaObDepth   = input.float(25.0, "OB: max. entry depth (% of range)", minval = 0, maxval = 100, step = 5, group = G_RA, tooltip = "How deep inside the range the triggering close may sit, measured from the swept side. Deeper closes are skipped.")
float  asiaFibDepth  = input.float(50.0, "Fib: min. reclaim depth (% of range)", minval = 0, maxval = 100, step = 5, group = G_RA, tooltip = "The fib model only arms once the reclaim candle closes at least this deep into the range.")
int    asiaMaxTrades = input.int(2, "Max. trades per Asia session", minval = 1, maxval = 5, group = G_RA)
int    asiaCloseH    = input.int(11, "Force-close open trades at", minval = 0, maxval = 23, group = G_RA, inline = "acl")
int    asiaCloseM    = input.int(0, ":", minval = 0, maxval = 59, group = G_RA, inline = "acl", tooltip = "Any trade from this range still open at this time is closed at market. Set the hour to 0 to switch it off.")

// ───────────────────────────────────────────────────────────────────────────────────────
// 3b LONDON RANGE
// ───────────────────────────────────────────────────────────────────────────────────────
bool   useLdn        = input.bool(true, "London range active", group = G_RL, tooltip = "Standalone range setup on the London pre-range, same rules as lunch and NY. The old location + double-sweep model lives in group 7b.")
string preSessInput  = input.session("0712-0812", "London range", group = G_RL)
string ldnEntryInput = input.session("0812-1000", "Entry window", group = G_RL)
int    ldnFibEndH    = input.int(11, "Fib limit valid until", minval = 0, maxval = 23, group = G_RL, inline = "lfe")
int    ldnFibEndM    = input.int(0, ":", minval = 0, maxval = 59, group = G_RL, inline = "lfe")
float  ldnSweepDist  = input.float(0.0, "Min. sweep distance (% of range)", minval = 0, step = 0.5, group = G_RL)
float  ldnObDepth    = input.float(25.0, "OB: max. entry depth (% of range)", minval = 0, maxval = 100, step = 5, group = G_RL)
float  ldnFibDepth   = input.float(50.0, "Fib: min. reclaim depth (% of range)", minval = 0, maxval = 100, step = 5, group = G_RL)
int    maxTradesInput = input.int(2, "Max. trades per London session", minval = 1, maxval = 5, group = G_RL)
int    ldnCloseH      = input.int(11, "Force-close open trades at", minval = 0, maxval = 23, group = G_RL, inline = "lcl")
int    ldnCloseM      = input.int(0, ":", minval = 0, maxval = 59, group = G_RL, inline = "lcl")

// ───────────────────────────────────────────────────────────────────────────────────────
// 3c LUNCH RANGE
// ───────────────────────────────────────────────────────────────────────────────────────
bool   useLunch        = input.bool(true, "Lunch range setup active", group = G_LUN, tooltip = "Standalone like NY: no location condition, only a sweep of the lunch range, OB and fib entries, targets measured on the lunch range.")
string lunchSessInput  = input.session("1200-1300", "Lunch range", group = G_LUN)
string lunchEntryInput = input.session("1300-1415", "Entry window", group = G_LUN)
int    lunchFibEndH    = input.int(15, "Fib limit valid until", minval = 0, maxval = 23, group = G_LUN, inline = "lue")
int    lunchFibEndM    = input.int(0, ":", minval = 0, maxval = 59, group = G_LUN, inline = "lue")
float  lunchSweepDist  = input.float(0.0, "Min. sweep distance (% of range)", minval = 0, step = 0.5, group = G_LUN)
float  lunchObDepth    = input.float(25.0, "OB: max. entry depth (% of range)", minval = 0, maxval = 100, step = 5, group = G_LUN)
float  lunchFibDepth   = input.float(50.0, "Fib: min. reclaim depth (% of range)", minval = 0, maxval = 100, step = 5, group = G_LUN)
int    lunchMaxTrades  = input.int(2, "Max. trades per lunch session", minval = 1, maxval = 5, group = G_LUN)
int    lunchCloseH     = input.int(0, "Force-close open trades at", minval = 0, maxval = 23, group = G_LUN, inline = "ucl")
int    lunchCloseM     = input.int(0, ":", minval = 0, maxval = 59, group = G_LUN, inline = "ucl", tooltip = "Hour 0 = off.")

// ───────────────────────────────────────────────────────────────────────────────────────
// 3d NY RANGE
// ───────────────────────────────────────────────────────────────────────────────────────
bool   useNY          = input.bool(true, "NY pre-range setup active", group = G_NY, tooltip = "Standalone range: sweep of its own range plus OB reclaim. No location condition.")
string nyPreSessInput = input.session("1412-1512", "NY pre-range", group = G_NY)
string nyEntrySessInput = input.session("1530-1630", "Entry window", group = G_NY, tooltip = "After it ends: no new NY trades, pending limits are cancelled, open trades run to SL/TP.")
int    nyFibEndH      = input.int(18, "Fib limit valid until", minval = 0, maxval = 23, group = G_NY, inline = "nfe")
int    nyFibEndM      = input.int(0, ":", minval = 0, maxval = 59, group = G_NY, inline = "nfe", tooltip = "If the reclaim happened inside the entry window, the fib limit may be placed and filled until this time. After that it is cancelled.")
float  nySweepDist    = input.float(0.0, "Min. sweep distance (% of range)", minval = 0, step = 0.5, group = G_NY)
float  nyObDepth      = input.float(25.0, "OB: max. entry depth (% of range)", minval = 0, maxval = 100, step = 5, group = G_NY)
float  nyFibDepth     = input.float(50.0, "Fib: min. reclaim depth (% of range)", minval = 0, maxval = 100, step = 5, group = G_NY)
int    nyMaxTrades    = input.int(2, "Max. trades per NY session", minval = 1, maxval = 5, group = G_NY)
int    nyCloseH       = input.int(0, "Force-close open trades at", minval = 0, maxval = 23, group = G_NY, inline = "ncl")
int    nyCloseM       = input.int(0, ":", minval = 0, maxval = 59, group = G_NY, inline = "ncl", tooltip = "Hour 0 = off.")
bool   ldnLocksNY     = input.bool(false, "Earlier session TP (Asia/London/Lunch) locks NY", group = G_NY, tooltip = "On: if a London or Asia trade reached TP today, NY will not trade any more. Off: NY still trades and keeps its own daily lock.")

// ───────────────────────────────────────────────────────────────────────────────────────
// 4a ENTRY-MODELL 1 - ORDERBLOCK RECLAIM
// ───────────────────────────────────────────────────────────────────────────────────────
bool   useOB          = input.bool(true, "Model 1 active", group = G_OB)
string obTriggerInput = input.string(OB_BODY, "Reclaim/entry: M5 close beyond", options = [OB_WICK, OB_BODY], group = G_OB)
// Tiefen-Filter liegen pro Range in Gruppe 3a-3d. Der Wert hier dient nur dem Legacy-London-Modell.

// ───────────────────────────────────────────────────────────────────────────────────────
// 4b ENTRY-MODELL 2 - FIB RETRACE LIMIT
// ───────────────────────────────────────────────────────────────────────────────────────
bool  useFib      = input.bool(true, "Model 2 active", group = G_FIB)
float fibLevel    = input.float(0.618, "Fib level", minval = 0.01, maxval = 0.99, step = 0.001, group = G_FIB)
// Tiefen-Filter liegen pro Range in Gruppe 3a-3d. Der Wert hier dient nur dem Legacy-London-Modell.

// ───────────────────────────────────────────────────────────────────────────────────────
// 4c ENTRY-MODELL 3 - DREI-KERZEN-ENGULFING
// ───────────────────────────────────────────────────────────────────────────────────────
// ───────────────────────────────────────────────────────────────────────────────────────
// Modell 3 (4c): Drei-Kerzen-Engulfing AUSSERHALB der Range, Ziel = volle Gegenseite.
// LONG:  drei bearische Kerzen unter der Range, deren Tief genommen wird, danach Close
//        über dem höchsten Körper der drei. Limit zurück auf den Körper, SL unter die
//        Manipulation, TP an die Range-Oberkante.
// SHORT: spiegelverkehrt.
// ───────────────────────────────────────────────────────────────────────────────────────
bool  useEng      = input.bool(false, "Model 3 master switch", group = G_ENG)
bool  engAsia     = input.bool(true, "Asia",   group = G_ENG, inline = "eng")
bool  engLdn      = input.bool(true, "London", group = G_ENG, inline = "eng")
bool  engLun      = input.bool(true, "Lunch",  group = G_ENG, inline = "eng")
bool  engNy       = input.bool(true, "NY",     group = G_ENG, inline = "eng")
float engBodyPct  = input.float(50.0, "Candle strength: body >= % of the candle range", minval = 10, maxval = 95, step = 5, group = G_ENG, tooltip = "Body must reach this share of the candle range. Doji-like and inside candles do not count.")
string engSeries  = input.string("Rolling - last three strong candles", "Series definition", options = ["Rolling - last three strong candles", "Exactly three candles"], group = G_ENG, tooltip = "Rolling: always the last three strong candles of a run. Exactly three: the candle before must be the opposite colour and a fourth same-direction candle discards the setup.")
bool  engRejCancel = input.bool(true, "Cancel limit if price reaches a range edge first", group = G_ENG, tooltip = "Price must return to the limit directly. A detour to a range edge counts as rejection and deletes the limit.")
string engRejScope = input.string("Nearest edge of any range", "Which edge counts", options = ["Nearest edge of any range", "Own range edge only"], group = G_ENG)
bool  engNeedSweep = input.bool(true, "Low/high of the three candles must be swept first", group = G_ENG, tooltip = "On: price must run through the low/high of the three before the engulf counts.")
float engDistPct  = input.float(100.0, "Max. distance from the range (% of range height)", minval = 10, step = 10, group = G_ENG, tooltip = "How far outside the range the setup may sit, in % of the range height.")
string engLvlMode = input.string("Outer body of the three", "Limit level", options = ["Outer body of the three", "Body of the last of the three"], group = G_ENG, tooltip = "Outer body = the body extreme the engulf broke through (open of the first candle). Last candle = body edge of the third.")
int   engOwnMax   = input.int(0, "Model 3: own trade budget per range (0 = share)", minval = 0, maxval = 5, group = G_ENG, tooltip = "0 = shares the range budget with the other models. 1+ = own budget per range.")
bool  engBlocksOB = input.bool(false, "Three-candle break disables the OB entry", group = G_ENG, tooltip = "On: if the breakout out of the range consists of three strong candles, only their engulf opens a trade. Needs model 3 active.")
bool  showEng     = input.bool(true, "Draw engulfing setups", group = G_ENG)

// ───────────────────────────────────────────────────────────────────────────────────────
// 4d ENTRY-MODELL 4 - FVG INVERSION
// ───────────────────────────────────────────────────────────────────────────────────────
// ───────────────────────────────────────────────────────────────────────────────────────
// Modell 4 (4d): FVG-Inversion. Die Range bricht, der Impuls hinterlässt eine FVG
// ausserhalb der Range. Schliesst der Preis später jenseits der gegenüberliegenden
// Kante dieser FVG, ist sie gebrochen und dreht ihre Rolle um. Der Rücklauf auf die
// invertierte Kante wird per Limit gehandelt, Ziel = Gegenseite der Range.
// ───────────────────────────────────────────────────────────────────────────────────────
bool  useFiv      = input.bool(false, "Model 4 master switch", group = G_FIV)
bool  fivAsia     = input.bool(true, "Asia",   group = G_FIV, inline = "fiv")
bool  fivLdn      = input.bool(true, "London", group = G_FIV, inline = "fiv")
bool  fivLun      = input.bool(true, "Lunch",  group = G_FIV, inline = "fiv")
bool  fivNy       = input.bool(true, "NY",     group = G_FIV, inline = "fiv")
bool  fivM5       = input.bool(true,  "FVG timeframe M5",  group = G_FIV, inline = "fivtf")
bool  fivM15      = input.bool(true,  "M15", group = G_FIV, inline = "fivtf")
bool  fivH1       = input.bool(false, "H1",  group = G_FIV, inline = "fivtf")
bool  fivH4       = input.bool(false, "H4",  group = G_FIV, inline = "fivtf")
int   fivBrkBars  = input.int(10, "Breakout window: max. candles", minval = 1, maxval = 60, group = G_FIV, tooltip = "Starts with the first close beyond the range edge, ends on the first close back inside or after this many candles.")
int   fivOwnMax   = input.int(1, "Model 4: own trade budget per range (0 = share)", minval = 0, maxval = 5, group = G_FIV, tooltip = "0 = shares the range budget. 1+ = own budget per range. Each inverted FVG is used only once.")
float fivDistPct  = input.float(100.0, "Max. distance from the range (% of range height)", minval = 10, step = 10, group = G_FIV, tooltip = "How far outside the range the inverted FVG may sit, in % of the range height.")
bool  showFiv     = input.bool(true, "Draw FVG inversion setups", group = G_FIV)

// ───────────────────────────────────────────────────────────────────────────────────────
// 5  LIQUIDITAETS-FILTER (nur Modell 1)
// ───────────────────────────────────────────────────────────────────────────────────────
// ───────────────────────────────────────────────────────────────────────────────────────
// Liquiditäts-Filter (5): drei unabhängige Zusatzbedingungen. Jeder Filter, der
// eingeschaltet ist, muss im laufenden Manipulations-Zyklus erfüllt sein, BEVOR der
// Reclaim-Entry gültig wird. Alle eingeschalteten Filter gelten gleichzeitig (UND).
// ───────────────────────────────────────────────────────────────────────────────────────
bool  useSwingFilter = input.bool(false, "Swing sweep required", group = G_LIQ, tooltip = "Price must take out the nearest swing level on the sweep side first.")
int   swingLen       = input.int(2, "Swing fractal length (bars each side)", minval = 1, maxval = 10, group = G_LIQ, tooltip = "2 = classic ICT fractal: a high with 2 lower highs on each side.")
bool  showSwings     = input.bool(true, "Draw swing levels", group = G_LIQ)

bool  useFvgFilter   = input.bool(false, "FVG dip required", group = G_LIQ, tooltip = "Price must dip into an unfilled FVG on the sweep side before reclaiming.")
bool  fvgM5          = input.bool(true,  "FVG timeframe M5",  group = G_LIQ, inline = "fvgtf")
bool  fvgM15         = input.bool(true,  "M15", group = G_LIQ, inline = "fvgtf")
bool  fvgH1          = input.bool(false, "H1",  group = G_LIQ, inline = "fvgtf")
bool  fvgH4          = input.bool(false, "H4",  group = G_LIQ, inline = "fvgtf")
bool  showFvg        = input.bool(true, "Draw FVGs", group = G_LIQ)

bool  useObFilter    = input.bool(false, "Orderblock tap required", group = G_LIQ, tooltip = "Price must tap the last opposite candle before a strong displacement move.")
float obDispPct      = input.float(30.0, "OB displacement (% of range)", minval = 1.0, maxval = 500.0, step = 5, group = G_LIQ, tooltip = "Required move after the OB candle, in % of the range height.")
int   obLookback     = input.int(20, "OB: keep last N zones", minval = 5, maxval = 50, group = G_LIQ)
bool  showObZones    = input.bool(true, "Draw orderblocks", group = G_LIQ)

// ───────────────────────────────────────────────────────────────────────────────────────
// 6a STOP LOSS / TAKE PROFIT
// ───────────────────────────────────────────────────────────────────────────────────────
float  slBufferPct    = input.float(0.0, "SL buffer beyond the sweep extreme (% of Asia range)", minval = 0, step = 0.5, group = G_RISK)
string tpModeInput    = input.string(TP_DUAL, "Take-profit model", options = [TP_DUAL, TP_FULL, TP_HALF, TP_CUST], group = G_RISK, tooltip = "Levels are measured from the swept side of the range. 100 % = opposite side. The Asia OB model uses its own R-based targets.")
float  tp1LevelPct    = input.float(50.0, "Dual: TP1 level (% of range)", minval = 1, maxval = 100, step = 5, group = G_RISK, inline = "dual")
float  tp2LevelPct    = input.float(100.0, "TP2 level (%)", minval = 1, maxval = 100, step = 5, group = G_RISK, inline = "dual")
float  tp1SplitPct    = input.float(50.0, "Dual: share closed at TP1 (%)", minval = 1, maxval = 99, step = 5, group = G_RISK)
float  tpCustomPct    = input.float(70.0, "Single TP Custom: level (% of range)", minval = 1, maxval = 100, step = 5, group = G_RISK)
bool   beAfterTp1     = input.bool(true, "Dual: move SL to break-even after TP1", group = G_RISK)

// ───────────────────────────────────────────────────────────────────────────────────────
// 6b SESSION-SPERREN
// ───────────────────────────────────────────────────────────────────────────────────────
bool   shareAsiaLdn   = input.bool(false, "Asia TP locks London and vice versa", group = G_LOCK, tooltip = "On: if the first trade (Asia or London) reaches TP, the other session stops trading. After a loss the second trade is still allowed.")
bool   prevLocksLunch = input.bool(false, "Asia/London TP locks lunch", group = G_LOCK)
bool   flattenPrev    = input.bool(false, "New session flattens earlier sessions", group = G_LOCK, tooltip = "On: when an entry window opens, open trades and armed limits of the earlier ranges are closed and cancelled.")

// ───────────────────────────────────────────────────────────────────────────────────────
// 6c NO-TRADE-ZONE
// ───────────────────────────────────────────────────────────────────────────────────────
bool   useNoTrade     = input.bool(true, "Block entries at the 50 % mark", group = G_NTZ, tooltip = "If the entry price (OB close or fib limit) falls inside the zone around the range midpoint, the setup is blocked. Applies to the London, lunch and NY pre-ranges.")
float  noTradeZone    = input.float(5.0, "Zone: 50 % +/- X % of the range", minval = 0.1, maxval = 49, step = 0.5, group = G_NTZ)
